  "version": "0.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir dist-expo",
    "preview": "expo start --web --no-dev",
    "legacy:dev": "tsx server.ts",
    "legacy:build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "legacy:start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
